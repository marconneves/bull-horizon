{
  "title": "Bull Horizon",
  "uid": "bull-horizon",
  "editable": true,
  "schemaVersion": 39,
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "tags": ["bull", "bullmq", "queues"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {}
      },
      {
        "name": "queue",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(bull_horizon_queue_jobs, queue)",
        "label": "Queue",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Throughput (jobs/min)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 12, "lineWidth": 2 }
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              {
                "id": "color",
                "value": { "mode": "fixed", "fixedColor": "red" }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(bull_horizon_jobs_completed_total{queue=~\"$queue\"}[5m])) * 60",
          "legendFormat": "completed"
        },
        {
          "refId": "B",
          "expr": "sum(rate(bull_horizon_jobs_failed_total{queue=~\"$queue\"}[5m])) * 60",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Failure rate",
      "description": "Share of finished jobs that failed, over the last 5 minutes.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.02 },
              { "color": "red", "value": 0.1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(bull_horizon_jobs_failed_total{queue=~\"$queue\"}[5m])) / clamp_min(sum(rate(bull_horizon_jobs_completed_total{queue=~\"$queue\"}[5m])) + sum(rate(bull_horizon_jobs_failed_total{queue=~\"$queue\"}[5m])), 0.0001)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Queue depth (waiting + delayed)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10, "lineWidth": 2, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (bull_horizon_queue_jobs{queue=~\"$queue\",status=~\"waiting|delayed\"})",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Active jobs",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (bull_horizon_queue_jobs{queue=~\"$queue\",status=\"active\"})",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Processing time (ms)",
      "description": "Reported per collect window, not a true histogram — avg/min/max of the jobs that finished in the window.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bull_horizon_job_processing_time_ms{queue=~\"$queue\"}",
          "legendFormat": "{{queue}} {{stat}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Paused queues",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "expr": "bull_horizon_queue_paused{queue=~\"$queue\"} == 1",
          "instant": true,
          "format": "table"
        }
      ]
    }
  ]
}
